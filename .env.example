# Formspree form ID from https://formspree.io (the part after /f/)
# Example: https://formspree.io/f/xpqvjowe → xpqvjowe
VITE_FORMSPREE_FORM_ID=xpqvjowe

# Extra Formspree CC is not used. Change the form recipient in the Formspree dashboard
# (currently skye@marketingbymosaic.com) to skye@hellomosaic.ai.

# Invite codes for /brief (growth diagnostic), comma-separated. Extra codes merge with MOSAIC, CHAMBER, REFERRAL, VERIFY.
VITE_BRIEF_CODES=MOSAIC,CHAMBER,REFERRAL,VERIFY
