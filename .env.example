# Formspree form ID from https://formspree.io (the part after /f/)
# Example: https://formspree.io/f/xpqvjowe → xpqvjowe
# Still used for leak check and SMS opt-in. Contact and /brief go through FormSubmit.
VITE_FORMSPREE_FORM_ID=xpqvjowe

# Inbox for FormSubmit (homepage contact + program brief).
VITE_BRIEF_NOTIFY_EMAIL=skye@hellomosaic.ai

# Invite codes for /brief (growth diagnostic), comma-separated. Extra codes merge with MOSAIC, CHAMBER, REFERRAL, VERIFY, INBOX.
VITE_BRIEF_CODES=MOSAIC,CHAMBER,REFERRAL,VERIFY,INBOX
